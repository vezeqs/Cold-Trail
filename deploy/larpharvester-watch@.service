[Unit]
Description=larpharvester watch cycle for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=larpharvester
Group=larpharvester
Environment=LARPHARVESTER_DB=/var/lib/larpharvester/larpharvester.db
EnvironmentFile=-/etc/larpharvester/env
ExecStart=/usr/local/bin/larpharvester watch %i --interval 3600
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/larpharvester
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
