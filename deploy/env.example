# Copy to /etc/coldtrail/env and `chmod 600` (owned by root).
# These are read by the systemd units in deploy/.

# Require a bearer token / login cookie for the web UI (recommended).
# COLDTRAIL_WEB_TOKEN=change-me-to-a-long-random-string

# Optional API keys.
# GITHUB_TOKEN=
# HIBP_API_KEY=
# EMAILREP_API_KEY=
# SHODAN_API_KEY=
# HUNTER_API_KEY=
# X_BEARER_TOKEN=

# Optional egress controls.
# COLDTRAIL_PROXY=socks5h://127.0.0.1:9050
# COLDTRAIL_TOR=true
