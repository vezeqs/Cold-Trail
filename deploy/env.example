# Copy to /etc/larpharvester/env and `chmod 600` (owned by root).
# These are read by the systemd units in deploy/.

# Require a bearer token / login cookie for the web UI (recommended).
# LARPHARVESTER_WEB_TOKEN=change-me-to-a-long-random-string

# Optional API keys.
# GITHUB_TOKEN=
# HIBP_API_KEY=
# EMAILREP_API_KEY=
# SHODAN_API_KEY=

# Optional egress controls.
# LARPHARVESTER_PROXY=socks5h://127.0.0.1:9050
# LARPHARVESTER_TOR=true
