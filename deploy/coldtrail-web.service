[Unit]
Description=ColdTrail local web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=coldtrail
Group=coldtrail
Environment=COLDTRAIL_DB=/var/lib/coldtrail/coldtrail.db
EnvironmentFile=-/etc/coldtrail/env
ExecStart=/usr/local/bin/coldtrail serve --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/coldtrail
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
